{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":enableVulnerabilityAlerts"],
  "platformAutomerge": true,
  "ignoreDeps": ["reqwest"],
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "matchCategories": ["docker"],
      "groupName": "Docker images",
      "pinDigests": false
    },
    {
      "description": "Major updates: manual review, never auto-merge",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "GitHub Actions: no shipped binary/image impact; auto-merge non-major without creating release tags",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true,
      "platformAutomerge": true,
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Artifact-impacting deps (Cargo, Docker, etc.): auto-merge non-major; release proposal handled separately",
      "matchManagers": ["cargo", "dockerfile", "docker-compose", "regex", "custom.regex"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest", "lockFileMaintenance"],
      "automerge": true,
      "platformAutomerge": true
    }
  ]
}
