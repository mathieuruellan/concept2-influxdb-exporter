{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "cargo": {
    "groupName": "Rust dependencies"
  },
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "matchCategories": ["docker"],
      "groupName": "Docker images",
      "pinDigests": false
    }
  ]
}
